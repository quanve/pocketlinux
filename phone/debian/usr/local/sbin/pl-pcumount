#!/bin/sh
if ! grep -q " /mnt/pc " /proc/mounts; then
    echo "pc: not mounted"
    exit 0
fi
/usr/bin/fusermount3 -u /mnt/pc 2>/dev/null
sleep 1
if grep -q " /mnt/pc " /proc/mounts; then
    pkill -f "sshfs .* /mnt/pc" 2>/dev/null
    sleep 1
    umount -l /mnt/pc 2>/dev/null
fi
if grep -q " /mnt/pc " /proc/mounts; then
    echo "pc: unmount FAILED"
    exit 1
fi
echo "pc: unmounted"
